{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./backend/dist",
    "rootDir": "./backend",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, // Allows default imports from modules without default exports
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "express"],
    "noEmit": true
  },
  "ts-node": {
    "esm": true
  },
  "include": ["backend/src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts", "frontend"]
}
